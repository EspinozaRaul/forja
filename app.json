{
  "expo": {
    "name": "Forja",
    "slug": "fitness-tracker",
    "version": "1.0.0",
    "scheme": "forja",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "assets/exercises/images/**/*",
      "assets/exercises/gifs/**/*"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.espinozar.fitnesstracker"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101316",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.espinoza21.fitnesstracker"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-video",
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#C77B45"
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c13be3e5-ece2-4588-b86e-ccd49e3c3a64"
      }
    }
  }
}
