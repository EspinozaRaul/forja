# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Local build credentials — SECRETS, never commit (see docs/release-runbook.md).
# credentials.json carries the keystore passwords in clear text and credentials/ carries
# the keystore itself. Both stay on this machine: that keystore is the identity of every
# published APK, and without it an update can never be signed again.
credentials.json
/credentials/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# build artifacts
*.apk
build-*/

# codegraph (local index)
.codegraph/

# releases (local copies)
releases/
# Local Pi runtime state
.atl/

# Pi agent local state
.pi/
